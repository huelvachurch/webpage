{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with roles and basic info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "roles": { 
          "type": "array", 
          "items": {
            "type": "string", 
            "enum": ["admin", "comunicador", "profesor", "alumno", "lider", "supervisor", "maestro", "financiero"]
          },
          "description": "User roles for access control"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "blocked"],
          "description": "Account status"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "notificationPreferences": {
          "type": "object",
          "properties": {
            "celula": { "type": "boolean", "description": "Update push alerts from the user's cell leader" },
            "liderazgo": { "type": "boolean", "description": "Supervisor/assistants notifications and leadership warnings" },
            "oracion": { "type": "boolean", "description": "Prayer group alerts 30 minutes before" },
            "cellMeet": { "type": "boolean", "description": "Cell meeting alerts 1 day before" },
            "publicaciones": { "type": "boolean", "description": "Notification when blogger / church announcements published" },
            "celebracion": { "type": "boolean", "description": "Celebration service countdown reminder 3 hours before" }
          },
          "description": "User notification channel preferences"
        }
      },
      "required": ["uid", "email", "roles"]
    },
    "Post": {
      "title": "Blog Post",
      "description": "Blog post or activity entry",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "featured": { "type": "boolean" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content", "authorId"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course with modality and content",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructorId": { "type": "string" },
        "instructorName": { "type": "string" },
        "modality": { "type": "string", "enum": ["self-paced", "scheduled"] },
        "durationMode": { "type": "string", "enum": ["unlimited", "limited", "flexible", "fixed"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "timeLimitDays": { "type": "number" },
        "imageUrl": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "instructorId", "modality", "durationMode"]
    },
    "CourseClass": {
      "title": "Course Class",
      "description": "A section/class within a course",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "requiresPrevious": { "type": "boolean" },
        "dayNumber": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "order"]
    },
    "CourseStep": {
      "title": "Course Step",
      "description": "An interactive step (theory or quiz) under a class",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["theory", "quiz"] },
        "order": { "type": "number" },
        "content": { "type": "string" },
        "attachments": { "type": "array" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "order"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment in a course",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "cellId": { "type": "string" },
        "cellName": { "type": "string" },
        "guideId": { "type": "string" },
        "guideName": { "type": "string" },
        "isPaused": { "type": "boolean" },
        "leaderApproved": { "type": "boolean" },
        "approvedClassIds": { "type": "array" },
        "classUnlockRequests": { "type": "array" },
        "quizAnswersMap": { "type": "object" },
        "classComments": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "active", "completed", "dropped"] },
        "grade": { "type": "number" },
        "progress": { "type": "number" },
        "enrolledAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "studentId", "status"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber email registration",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "active"]
    },
    "Newsletter": {
      "title": "Newsletter Campaign",
      "description": "Newsletter email campaign template, draft, sent history, or scheduled record",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["semanal", "especial"] },
        "subject": { "type": "string" },
        "contentHtml": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "scheduled", "sent"] },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "sentAt": { "type": "string", "format": "date-time" },
        "sentCount": { "type": "number" },
        "config": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "subject", "contentHtml", "status"]
    },
    "MeetingReport": {
      "title": "Meeting Report",
      "description": "Weekly group meeting report submitted by a cell group leader",
      "type": "object",
      "properties": {
        "leaderId": { "type": "string" },
        "leaderName": { "type": "string" },
        "meetingDate": { "type": "string" },
        "believersCount": { "type": "number" },
        "nonBelieversCount": { "type": "number" },
        "totalPresent": { "type": "number" },
        "believersNames": { "type": "string" },
        "nonBelieversNames": { "type": "string" },
        "believersBaptizedCount": { "type": "number" },
        "believersNotBaptizedCount": { "type": "number" },
        "believersBaptizedNames": { "type": "string" },
        "believersNotBaptizedNames": { "type": "string" },
        "comments": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["leaderId", "leaderName", "meetingDate", "believersCount", "nonBelieversCount", "totalPresent", "believersNames", "nonBelieversNames"]
    },
    "CellMember": {
      "title": "Cell Member Memory",
      "description": "Cell attendee memory tracked per leader to enable automated attendance tags",
      "type": "object",
      "properties": {
        "leaderId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["bautizado", "no_bautizado", "no_creyente"] },
        "consecutiveAbsences": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["leaderId", "name", "category", "consecutiveAbsences", "updatedAt"]
    },
    "LeaderAnnouncement": {
      "title": "Leader Announcement",
      "description": "Announcement bulletin from admin users specific to cell group leaders",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "authorId", "authorName"]
    },
    "CellStudy": {
      "title": "Cell Study Link",
      "description": "Cell study material link shared by a leader or admin",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "link": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "link", "authorId", "authorName"]
    },
    "Celula": {
      "title": "Celula Location",
      "description": "Cell group location and schedule details managed by leader or admin",
      "type": "object",
      "properties": {
        "leaderId": { "type": "string" },
        "leader": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "barriada": { "type": "string" },
        "ciudad": { "type": "string" },
        "schedule": { "type": "string" },
        "googleMapsLink": { "type": "string" },
        "coLeaderId": { "type": "string" },
        "coLeaderName": { "type": "string" },
        "coLeaderEmail": { "type": "string" },
        "coLeaderInviteeId": { "type": "string" },
        "coLeaderInviteeName": { "type": "string" },
        "coLeaderInviteeEmail": { "type": "string" },
        "coLeaderInvitationStatus": { "type": "string" }
      },
      "required": ["leaderId", "leader", "name", "address", "barriada", "ciudad", "schedule"]
    },
    "KidsProgram": {
      "title": "Kids Program",
      "description": "Teaching schedule for a specific Sunday in Kids Ministry",
      "type": "object",
      "properties": {
        "teachingTitle": { "type": "string" },
        "teachingLink": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teachingTitle", "teachingLink", "teacherId", "teacherName", "date"]
    },
    "KidsComment": {
      "title": "Kids Comment",
      "description": "Comment posted by a teacher in the Kids Ministry section",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "authorId", "authorName"]
    },
    "KidsPhoto": {
      "title": "Kids Photo",
      "description": "Photo shared in the Kids Ministry gallery",
      "type": "object",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "dateTaken": { "type": "string" },
        "uploadedById": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "dateTaken", "uploadedById", "uploadedByName"]
    },
    "KidsNotification": {
      "title": "Kids Notification",
      "description": "Notification for teachers in the Kids Ministry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "actionUrl": { "type": "string" }
      },
      "required": ["userId", "title", "body", "read"]
    },
    "FinanceTransaction": {
      "title": "Finance Transaction",
      "description": "Church treasury income or expense transaction",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ingreso", "gasto"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "concept": { "type": "string" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["Efectivo", "Transferencia", "Bizum", "Tarjeta", "Otro"] },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" },
        "registeredByUid": { "type": "string" },
        "registeredByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount", "category", "concept", "date", "paymentMethod"]
    },
    "ChurchArea": {
      "title": "Church Area",
      "description": "Church area (Servicios or Ministeriales) with name and initials for finance and organization",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["Servicios", "Ministeriales"] },
        "initials": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "initials"]
    },
    "Reembolso": {
      "title": "Solicitud de Reembolso",
      "description": "Member reimbursement request for church expenses",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdByEmail": { "type": "string" },
        "createdByPhone": { "type": "string" },
        "date": { "type": "string" },
        "areaId": { "type": "string" },
        "areaName": { "type": "string" },
        "areaInitials": { "type": "string" },
        "concept": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Efectivo", "Transferencia Bancaria"] },
        "iban": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pendiente", "incompleto", "completado"] },
        "signatures": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "createdByName", "date", "areaName", "concept", "amount", "paymentMethod", "status"]
    }
  },
  "firestore": {
    "/areas/{areaId}": {
      "schema": "ChurchArea",
      "description": "Collection of configured church areas (Servicios and Ministeriales)"
    },
    "/reembolsos/{reembolsoId}": {
      "schema": "Reembolso",
      "description": "Collection of member reimbursement requests"
    },
    "/finanzas_caja_chica/{movId}": {
      "schema": "FinanceTransaction",
      "description": "Collection of petty cash movements"
    },
    "/finanzas_cafeteria/{movId}": {
      "schema": "FinanceTransaction",
      "description": "Collection of cafeteria petty cash movements"
    },
    "/finanzas_libreria/{movId}": {
      "schema": "FinanceTransaction",
      "description": "Collection of bookstore petty cash movements"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/celulas/{celulaId}": {
      "schema": "Celula",
      "description": "Collection of cell group locations"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of blog posts and activities"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Collection of courses"
    },
    "/courses/{courseId}/classes/{classId}": {
      "schema": "CourseClass",
      "description": "Subcollection of sections/clases within a course"
    },
    "/courses/{courseId}/classes/{classId}/steps/{stepId}": {
      "schema": "CourseStep",
      "description": "Subcollection of steps/pasos within a course class"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Collection of course enrollments"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Collection of newsletter subscribers"
    },
    "/newsletters/{newsletterId}": {
      "schema": "Newsletter",
      "description": "Collection of sent, draft, or scheduled newsletters"
    },
    "/meeting_reports/{reportId}": {
      "schema": "MeetingReport",
      "description": "Collection of leader meeting reports/statistics"
    },
    "/leader_announcements/{announcementId}": {
      "schema": "LeaderAnnouncement",
      "description": "Collection of announcements for cell leaders"
    },
    "/cell_studies/{studyId}": {
      "schema": "CellStudy",
      "description": "Collection of cell studies and materials links shared by leaders/admins"
    },
    "/cell_members/{memberId}": {
      "schema": "CellMember",
      "description": "Collection of cell group attendees/members memory for auto-attendance badges"
    },
    "/kids_programs/{programId}": {
      "schema": "KidsProgram",
      "description": "Collection of kids teaching programs"
    },
    "/kids_comments/{commentId}": {
      "schema": "KidsComment",
      "description": "Collection of comments in the Kids Ministry"
    },
    "/kids_photos/{photoId}": {
      "schema": "KidsPhoto",
      "description": "Collection of kids photos for gallery"
    },
    "/kids_notifications/{notificationId}": {
      "schema": "KidsNotification",
      "description": "Collection of notifications for Kids Ministry teachers"
    }
  }
}
