rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required, format: email) - User email
    //   - displayName: string (optional) - User display name
    //   - photoURL: string (optional, format: uri) - User photo URL
    //   - roles: list (required, items: ['admin', 'comunicador', 'profesor', 'alumno']) - User roles
    //   - status: string (required, enum: ['pending', 'active', 'blocked']) - Account status
    //   - createdAt: timestamp (required) - Account creation time
    //
    // Collection: posts
    // Document ID: postId (auto-generated)
    // Fields:
    //   - title: string (required) - Post title
    //   - slug: string (required) - URL slug
    //   - excerpt: string (optional) - Short summary
    //   - content: string (required) - Main content (HTML/Markdown)
    //   - imageUrl: string (optional, format: uri) - Main image URL
    //   - category: string (optional) - Post category
    //   - tags: list (optional) - List of tags
    //   - authorId: string (required) - UID of the author
    //   - authorName: string (optional) - Name of the author
    //   - featured: bool (optional) - If the post is featured
    //   - publishedAt: timestamp (required) - Publication time
    //   - updatedAt: timestamp (required) - Last update time
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)huelvachurch@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
          'superadmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        ))
      );
    }

    function isComunicador() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'comunicador' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    function isProfesor() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'profesor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    function isLider() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'lider' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    function isSupervisor() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'supervisor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    function isMaestro() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'maestro' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    function isFinanciero() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'financiero' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles)
      );
    }

    function isCoLeaderOf(leaderId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/celulas/$(leaderId)) &&
        get(/databases/$(database)/documents/celulas/$(leaderId)).data.coLeaderId == request.auth.uid &&
        get(/databases/$(database)/documents/celulas/$(leaderId)).data.coLeaderInvitationStatus == 'accepted'
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'roles', 'status']) &&
             data.uid is string &&
             data.email is string &&
             data.roles is list &&
             data.status in ['pending', 'active', 'blocked'];
    }

    function isValidPost(data) {
      return data.keys().hasAll(['title', 'slug', 'content', 'authorId']) &&
             data.title is string && data.title.size() < 200 &&
             data.slug is string && data.slug.size() < 200 &&
             data.content is string && data.content.size() < 50000 &&
             data.authorId is string;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['title', 'instructorId', 'modality', 'durationMode']) &&
             data.title is string && data.title.size() < 200 &&
             data.instructorId is string &&
             data.modality in ['self-paced', 'scheduled'] &&
             data.durationMode in ['unlimited', 'limited', 'flexible', 'fixed'];
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['courseId', 'studentId', 'status']) &&
             data.courseId is string &&
             data.studentId is string &&
             data.status in ['pending', 'active', 'completed', 'dropped'];
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'active']) &&
             data.email is string && data.email.size() < 150 &&
             data.active is bool;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['type', 'subject', 'contentHtml', 'status']) &&
             data.type in ['semanal', 'especial'] &&
             data.subject is string && data.subject.size() < 500 &&
             data.contentHtml is string && data.contentHtml.size() < 100000 &&
             data.status in ['draft', 'scheduled', 'sent', 'sending'];
    }

    function isValidMeetingReport(data) {
      return data.keys().hasAll(['leaderId', 'leaderName', 'meetingDate']) &&
             data.leaderId is string &&
             data.leaderName is string &&
             data.meetingDate is string &&
             (!('believersCount' in data) || data.believersCount is int || data.believersCount is float) &&
             (!('nonBelieversCount' in data) || data.nonBelieversCount is int || data.nonBelieversCount is float) &&
             (!('totalPresent' in data) || data.totalPresent is int || data.totalPresent is float) &&
             (!('believersNames' in data) || data.believersNames is string) &&
             (!('nonBelieversNames' in data) || data.nonBelieversNames is string);
    }

    function isValidLeaderAnnouncement(data) {
      return data.keys().hasAll(['content', 'authorId', 'authorName']) &&
             data.content is string && data.content.size() < 10000 &&
             data.authorId is string &&
             data.authorName is string;
    }

    function isValidCellStudy(data) {
      return data.keys().hasAll(['title', 'link', 'authorId', 'authorName']) &&
             data.title is string && data.title.size() < 250 &&
             data.link is string && data.link.size() < 1000 &&
             data.authorId is string &&
             data.authorName is string;
    }

    function isValidCelula(data) {
      return data.keys().hasAll(['leaderId', 'leader', 'name', 'address', 'barriada', 'ciudad', 'schedule']) &&
             data.leaderId is string &&
             data.leader is string &&
             data.name is string &&
             data.address is string &&
             data.barriada is string &&
             data.ciudad is string &&
             data.schedule is string &&
             (!('coLeaderId' in data) || data.coLeaderId == null || data.coLeaderId is string) &&
             (!('coLeaderName' in data) || data.coLeaderName == null || data.coLeaderName is string) &&
             (!('coLeaderEmail' in data) || data.coLeaderEmail == null || data.coLeaderEmail is string) &&
             (!('coLeaderInviteeId' in data) || data.coLeaderInviteeId == null || data.coLeaderInviteeId is string) &&
             (!('coLeaderInviteeName' in data) || data.coLeaderInviteeName == null || data.coLeaderInviteeName is string) &&
             (!('coLeaderInviteeEmail' in data) || data.coLeaderInviteeEmail == null || data.coLeaderInviteeEmail is string) &&
             (!('coLeaderInvitationStatus' in data) || data.coLeaderInvitationStatus == null || data.coLeaderInvitationStatus is string);
    }

    function isValidCellMember(data) {
      return data.keys().hasAll(['leaderId', 'name', 'category']) &&
             data.leaderId is string &&
             data.name is string && data.name.size() < 150 &&
             data.category is string && data.category in ['bautizado', 'no_bautizado', 'no_creyente'] &&
             (!('consecutiveAbsences' in data) || data.consecutiveAbsences is int || data.consecutiveAbsences is float);
    }

    function isValidContactNotification(data) {
      return data.nombre is string &&
             data.whatsapp is string &&
             data.email is string &&
             data.zona is string && 
             data.leaderId is string &&
             data.createdAt is string;
    }

    function isValidKidsProgram(data) {
      return data.keys().hasAll(['teachingTitle', 'teachingLink', 'teacherId', 'teacherName', 'date']) &&
             data.teachingTitle is string && data.teachingTitle.size() < 300 &&
             data.teachingLink is string && data.teachingLink.size() < 1000 &&
             data.teacherId is string &&
             data.teacherName is string &&
             data.date is string;
    }

    function isValidKidsComment(data) {
      return data.keys().hasAll(['content', 'authorId', 'authorName']) &&
             data.content is string && data.content.size() < 5000 &&
             data.authorId is string &&
             data.authorName is string;
    }

    function isValidKidsPhoto(data) {
      return data.keys().hasAll(['url', 'dateTaken', 'uploadedById', 'uploadedByName']) &&
             data.url is string && data.url.size() < 1000 &&
             data.dateTaken is string &&
             data.uploadedById is string &&
             data.uploadedByName is string;
    }

    function isValidKidsNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'body', 'read']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 300 &&
             data.body is string && data.body.size() < 1000 &&
             data.read is bool;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /studies/{studyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /WeeklyStudy/{docId} {
      allow read: if true;
    }

    match /weeklyStudies/{docId} {
      allow read: if true;
    }

    match /weekly_studies/{docId} {
      allow read: if true;
    }

    match /user_study_interactions/{interactionId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (
        isOwner(userId) || isAdmin()
      );
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (
        isOwner(userId) || 
        isAdmin() ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supervisorId'])) ||
        // Allow leaders/co-leaders to moderate cell access requests for their cell
        (isLider() && resource.data.celulaId != null && 
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['celulaStatus', 'celulaId']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['celulaStatus', 'celulaId']) &&
          (
            exists(/databases/$(database)/documents/celulas/$(resource.data.celulaId)) && 
            (
              get(/databases/$(database)/documents/celulas/$(resource.data.celulaId)).data.leaderId == request.auth.uid ||
              (
                get(/databases/$(database)/documents/celulas/$(resource.data.celulaId)).data.coLeaderId == request.auth.uid &&
                get(/databases/$(database)/documents/celulas/$(resource.data.celulaId)).data.coLeaderInvitationStatus == 'accepted'
              )
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true; // Publicly readable
      allow create: if isComunicador() && isValidPost(request.resource.data);
      allow update: if isComunicador() && isValidPost(request.resource.data);
      allow delete: if isComunicador();
    }

    match /courses/{courseId} {
      allow read: if true; // Courses are public
      allow create: if isProfesor() && isValidCourse(request.resource.data);
      allow update: if isProfesor() && isValidCourse(request.resource.data) && (request.resource.data.instructorId == resource.data.instructorId || isAdmin());
      allow delete: if isProfesor() && (resource.data.instructorId == request.auth.uid || isAdmin());

      match /classes/{classId} {
        allow read: if isAuthenticated();
        allow write: if isProfesor();

        match /steps/{stepId} {
          allow read: if isAuthenticated();
          allow write: if isProfesor();
        }
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.studentId || isProfesor());
      allow create: if isAuthenticated() && isValidEnrollment(request.resource.data) && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.studentId && (
          request.resource.data.status == 'dropped' ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'completedSteps', 'updatedAt'])
        )) ||
        isProfesor()
      );
      allow delete: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow read: if isComunicador() || (isAuthenticated() && (subscriberId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow create: if isValidSubscriber(request.resource.data);
      allow update: if (isComunicador() || (isAuthenticated() && (subscriberId == request.auth.uid || resource.data.email == request.auth.token.email))) && isValidSubscriber(request.resource.data);
      allow delete: if isComunicador();
    }

    match /newsletters/{newsletterId} {
      allow read: if true;
      allow create: if isComunicador() && isValidNewsletter(request.resource.data);
      allow update: if isComunicador() && isValidNewsletter(request.resource.data);
      allow delete: if isComunicador();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meeting_reports/{reportId} {
      allow read: if isAdmin() || isLider() || isSupervisor();
      allow create: if isValidMeetingReport(request.resource.data) && (isAdmin() || isLider() || request.resource.data.leaderId == request.auth.uid || isCoLeaderOf(request.resource.data.leaderId));
      allow update: if isLider() && isValidMeetingReport(request.resource.data) && 
                      (request.resource.data.leaderId == request.auth.uid || isCoLeaderOf(request.resource.data.leaderId)) && 
                      (resource.data.leaderId == request.auth.uid || isCoLeaderOf(resource.data.leaderId));
      allow delete: if isAdmin();
    }

    match /celulas/{celulaId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidCelula(request.resource.data) && (isAdmin() || request.resource.data.leaderId == request.auth.uid);
      allow update: if isAuthenticated() && isValidCelula(request.resource.data) && (
        isAdmin() || 
        (isLider() && resource.data.leaderId == request.auth.uid && request.resource.data.leaderId == request.auth.uid) ||
        // Invite/Acceptance workflow
        (resource.data.coLeaderInviteeId == request.auth.uid && request.resource.data.coLeaderId == request.auth.uid && request.resource.data.coLeaderInvitationStatus == 'accepted') ||
        (resource.data.coLeaderInviteeId == request.auth.uid && request.resource.data.coLeaderInviteeId == null) ||
        (resource.data.coLeaderId == request.auth.uid && request.resource.data.coLeaderId == null)
      );
      allow delete: if isAdmin();
    }

    match /leader_announcements/{announcementId} {
      allow read: if isLider();
      allow create: if isAdmin() && isValidLeaderAnnouncement(request.resource.data);
      allow update: if isAdmin() && isValidLeaderAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }

    match /supervisor_notifications/{notificationId} {
      allow read: if isLider() || isSupervisor();
      allow create: if isSupervisor() && request.resource.data.supervisorId == request.auth.uid;
      allow update: if isSupervisor() && resource.data.supervisorId == request.auth.uid && request.resource.data.supervisorId == request.auth.uid;
      allow delete: if isSupervisor() && resource.data.supervisorId == request.auth.uid;
    }

    match /cell_notifications/{notificationId} {
      allow read: if true;
      allow create: if isLider() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isLider() && resource.data.leaderId == request.auth.uid && request.resource.data.leaderId == request.auth.uid;
      allow delete: if isLider() && resource.data.leaderId == request.auth.uid;
    }

    match /cell_studies/{studyId} {
      allow read: if true; // allow all members to see studies for cells
      allow create: if isLider() && isValidCellStudy(request.resource.data);
      allow update: if isLider() && isValidCellStudy(request.resource.data) && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isLider() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /cell_members/{memberId} {
      allow read: if true; // Public retrieval for shared collaborative forms
      allow create: if isValidCellMember(request.resource.data);
      allow update: if isValidCellMember(request.resource.data);
      allow delete: if true; // Members can be removed automatically when consecutive absences reach 10
    }

    match /contact_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        (isLider() && resource.data.leaderId == request.auth.uid) ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid)
      );
      allow create: if isValidContactNotification(request.resource.data);
      allow update: if isAuthenticated() && (
        (isLider() && resource.data.leaderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByLeader'])) ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBySupervisor']))
      );
      allow delete: if isAuthenticated() && (
        (isLider() && resource.data.leaderId == request.auth.uid) ||
        (isSupervisor() && resource.data.supervisorId == request.auth.uid)
      );
    }

    match /kids_programs/{programId} {
      allow read: if true;
      allow create, update: if isMaestro() && isValidKidsProgram(request.resource.data);
      allow delete: if isMaestro();
    }

    match /kids_comments/{commentId} {
      allow read: if isMaestro();
      allow create: if isMaestro() && isValidKidsComment(request.resource.data);
      allow update: if isMaestro() && isValidKidsComment(request.resource.data) && resource.data.authorId == request.auth.uid;
      allow delete: if isMaestro() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /kids_photos/{photoId} {
      allow read: if true;
      allow create: if isMaestro() && isValidKidsPhoto(request.resource.data);
      allow update: if isMaestro() && isValidKidsPhoto(request.resource.data) && resource.data.uploadedById == request.auth.uid;
      allow delete: if isMaestro() && (resource.data.uploadedById == request.auth.uid || isAdmin());
    }

    match /kids_notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isMaestro() && isValidKidsNotification(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /finanzas/{transactionId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_etiquetas/{tagId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_bancarios/{movId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_celebraciones/{ingresoId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_arqueos/{arqueoId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_caja_chica/{movId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_cafeteria/{movId} {
      allow read, write: if isFinanciero();
    }

    match /finanzas_libreria/{movId} {
      allow read, write: if isFinanciero();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin() || isFinanciero();
    }

    match /reembolsos/{reembolsoId} {
      allow read: if isFinanciero() || (isAuthenticated() && resource.data.createdByUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isFinanciero();
    }
  }
}
